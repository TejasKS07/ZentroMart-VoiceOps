# Relative paths resolve against the project root, even from another directory.
DATASET_DIR=./Dataset
RUNTIME_DIR=./runtime

# Google-hosted Gemma 4 uses the native generateContent endpoint automatically.
# Other models use the text Chat Completions HTTP contract.
# Set the complete endpoint, including /chat/completions. No provider is assumed.
LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_MODEL=gemma-4-31b-it
LLM_API_KEY=
# Local unauthenticated endpoints may leave LLM_API_KEY empty.
API_TIMEOUT_SECONDS=90
# Optional: leave blank to retain provider defaults. Keep fixed between stages.
LLM_TEMPERATURE=0.2
LLM_REASONING_EFFORT=minimal
# Keep false during development; enable for final live evaluation.
LLM_CALLS_ENABLED=false

GNANI_API_KEY=
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Kaveri
GNANI_LANGUAGE=en-IN

# Explicit STT model; caller clips are capped at 30 seconds.
GNANI_STT_MODEL=prisma-v3.0

# Requested retrieval model: Google's Gemini Embedding 1, 768 dimensions.
EMBEDDING_PROVIDER=gemini
# May be blank when LLM_API_KEY is the same Google Gemini API key.
EMBEDDING_API_KEY=

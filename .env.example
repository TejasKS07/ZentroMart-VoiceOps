# Relative paths resolve against the project root, even from another directory.
DATASET_DIR=./Dataset
RUNTIME_DIR=./runtime

# Any endpoint implementing the text Chat Completions HTTP contract.
# Set the complete endpoint, including /chat/completions. No provider is assumed.
LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
# Local unauthenticated endpoints may leave LLM_API_KEY empty.
API_TIMEOUT_SECONDS=45
# Optional: leave blank to retain provider defaults. Keep fixed between stages.
LLM_TEMPERATURE=
LLM_REASONING_EFFORT=
# Keep false during development; enable for final live evaluation.
LLM_CALLS_ENABLED=false

GNANI_API_KEY=
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Kaveri
GNANI_LANGUAGE=en-IN

